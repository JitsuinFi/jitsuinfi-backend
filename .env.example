# Copy to .env (git-ignored) for local runs; on Railway set the same names as variables.
# Never paste the values in chat, the vault or a log (D-33).

# Supabase Postgres connection string (Project Settings > Database > Connection string, URI).
# Empty: the relay keeps everything in memory (lost on restart).
DATABASE_URL=

# Optional: a separate database or schema for `npm test` against Postgres. Empty: those tests skip.
TEST_DATABASE_URL=

PORT=8787
RETENTION_DAYS=30
MAX_MESSAGES_PER_MAILBOX=200
CHALLENGE_TTL_SECONDS=120
READ_TOKEN_TTL_SECONDS=600
